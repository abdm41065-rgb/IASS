require('dotenv').config();
const express = require('express');
const cors = require('cors');
const nodemailer = require('nodemailer');
const Twilio = require('twilio');

const app = express();
app.use(cors());
app.use(express.json({ limit: '200kb' }));

const PORT = process.env.PORT || 4001;
const API_KEY = process.env.NOTIFY_API_KEY || '';

// SMTP transporter (optional)
let mailer = null;
if(process.env.SMTP_HOST && process.env.SMTP_USER){
  mailer = nodemailer.createTransport({
    host: process.env.SMTP_HOST,
    port: Number(process.env.SMTP_PORT) || 587,
    secure: (process.env.SMTP_SECURE === 'true'),
    auth: {
      user: process.env.SMTP_USER,
      pass: process.env.SMTP_PASS
    }
  });
}

// Twilio client (optional)
let twClient = null;
if(process.env.TWILIO_ACCOUNT_SID && process.env.TWILIO_AUTH_TOKEN){
  twClient = Twilio(process.env.TWILIO_ACCOUNT_SID, process.env.TWILIO_AUTH_TOKEN);
}

// Simple middleware to check x-api-key if API_KEY configured
app.use((req, res, next) => {
  if(API_KEY){
    const key = req.get('x-api-key') || '';
    if(!key || key !== API_KEY) return res.status(401).json({ ok:false, error: 'invalid api key' });
  }
  next();
});

app.post('/notify-subscription', async (req, res) => {
  try{
    const payload = req.body || {};
    const member = payload.member || payload || null;
    const adminPhone = payload.adminPhone || process.env.ADMIN_PHONE || '';
    const adminEmail = payload.adminEmail || process.env.ADMIN_EMAIL || '';

    if(!member) return res.status(400).json({ ok:false, error:'missing member payload' });

    const name = member.name || '-';
    const email = member.email || '-';
    const phone = member.phone || member.contact || '-';
    const requestedAt = member.requestedAt || new Date().toISOString();

    const bodyText = `طلب اشتراك جديد - IAAS\n\nالاسم: ${name}\nالإيميل: ${email}\nالهاتف: ${phone}\nالخدمة: ${member.serviceType || '-'}\nوقت الطلب: ${requestedAt}`;

    const result = { emailSent:false, whatsappSent:false };

    // send email if transporter available and adminEmail present
    if(mailer && adminEmail){
      try{
        await mailer.sendMail({
          from: process.env.FROM_EMAIL || process.env.SMTP_USER,
          to: adminEmail,
          subject: 'طلب اشتراك جديد - IAAS',
          text: bodyText
        });
        result.emailSent = true;
      }catch(e){ console.error('mail send failed', e); }
    }

    // send WhatsApp via Twilio if configured and adminPhone present
    if(twClient && process.env.TWILIO_WHATSAPP_FROM && adminPhone){
      try{
        const from = `whatsapp:${process.env.TWILIO_WHATSAPP_FROM}`;
        const to = adminPhone.startsWith('whatsapp:') ? adminPhone : `whatsapp:${adminPhone}`;
        await twClient.messages.create({ from, to, body: bodyText });
        result.whatsappSent = true;
      }catch(e){ console.error('twilio send failed', e); }
    }

    return res.json({ ok:true, result });
  }catch(e){
    console.error(e);
    return res.status(500).json({ ok:false, error: String(e) });
  }
});

app.get('/', (req, res) => res.json({ ok:true, message: 'IAAS notify server' }));

app.listen(PORT, ()=> console.log(`IAAS notify server running on port ${PORT}`));
