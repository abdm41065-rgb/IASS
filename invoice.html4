<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>جدولة المصاريف | IAAS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=Noto+Kufi+Arabic:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
:root {
  --void:       #020304;
  --deep:       #060810;
  --surface:    #0a0d14;
  --surface2:   #0f1320;
  --surface3:   #141a28;
  --card:       #0c1019;
  --line:       rgba(255,255,255,0.055);
  --line2:      rgba(255,255,255,0.1);
  --line3:      rgba(255,255,255,0.16);
  --text:       #edf0f5;
  --text2:      #b8bfcc;
  --muted:      #6e7a8e;
  --dim:        #2e3649;
  --gold:       #c9aa6f;
  --gold2:      #e8cb8a;
  --gold3:      #f5dfa0;
  --gold-glow:  rgba(201,170,111,0.15);
  --red:        #f04060;
  --green:      #20c878;
  --blue:       #3a7fff;
  --r:          12px;
  --r2:         18px;
  --font-en:    'Syne', sans-serif;
  --font-ar:    'Noto Kufi Arabic', sans-serif;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; font-size: 15px; }
body {
  font-family: var(--font-ar);
  background: radial-gradient(circle at 20% 15%, rgba(201,170,111,0.05), transparent 30%),
              radial-gradient(circle at 80% 10%, rgba(58,127,255,0.04), transparent 25%),
              var(--void);
  color: var(--text);
  min-height: 100vh; padding: 0;
  -webkit-font-smoothing: antialiased;
}
a { text-decoration: none; color: inherit; }
button { font-family: var(--font-ar); }
::-webkit-scrollbar { width: 3px; }
::-webkit-scrollbar-track { background: var(--void); }
::-webkit-scrollbar-thumb { background: var(--dim); border-radius: 99px; }

/* ── TOPBAR ── */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 28px;
  background: rgba(10,13,20,0.9);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--line);
  position: sticky; top: 0; z-index: 100;
}
.topbar-brand { display: flex; align-items: center; gap: 12px; }
.topbar-logo {
  font-family: var(--font-en); font-size: 18px; font-weight: 800;
  letter-spacing: 3px; color: var(--gold2);
}
.topbar-sep { width: 1px; height: 20px; background: var(--line2); }
.topbar-title { font-size: 14px; font-weight: 600; color: var(--text2); }
.topbar-back {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 16px; border-radius: var(--r);
  background: rgba(255,255,255,0.04); border: 1px solid var(--line);
  color: var(--text2); font-size: 13px; font-weight: 600;
  cursor: pointer; transition: all 0.25s;
}
.topbar-back:hover { background: rgba(255,255,255,0.08); transform: translateX(3px); }

/* ── SHELL ── */
.shell { max-width: 1400px; margin: 0 auto; padding: 28px 20px 60px; display: grid; gap: 22px; }

/* ── MAIN TWO-COL LAYOUT: table + analytics ── */
.main-layout {
  display: grid; grid-template-columns: 1.6fr 1fr; gap: 16px; align-items: start;
}
.main-layout > .table-panel { min-width: 0; }
.main-layout > .analytics-section { min-width: 0; position: sticky; top: 70px; }

/* ── INCOME SECTION ── */
.income-panel {
  background: var(--card); border: 1px solid var(--line);
  border-radius: var(--r2); padding: 24px;
  display: grid; grid-template-columns: 1fr auto; gap: 14px; align-items: end;
  position: relative; overflow: hidden;
}
.income-panel::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, var(--green), var(--gold), var(--green));
}
.income-label { font-size: 13px; color: var(--muted); margin-bottom: 6px; }
.income-display {
  font-family: var(--font-en); font-size: 38px; font-weight: 800; color: var(--green);
  letter-spacing: 0.5px; transition: color 0.3s;
}
.fi {
  width: 100%; padding: 11px 14px;
  background: var(--surface2); border: 1px solid var(--line);
  border-radius: var(--r); color: var(--text);
  font-family: var(--font-ar); font-size: 14px;
  transition: all 0.25s; outline: none;
}
.fi::placeholder { color: var(--dim); }
.fi:focus { border-color: rgba(201,170,111,0.4); box-shadow: 0 0 0 3px rgba(201,170,111,0.08); }
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  padding: 11px 20px; border-radius: var(--r);
  font-family: var(--font-ar); font-size: 13px; font-weight: 700;
  cursor: pointer; transition: all 0.25s; border: 1px solid var(--line2);
  background: transparent; color: var(--text); white-space: nowrap;
}
.btn:hover { transform: translateY(-1px); }
.btn-green {
  background: rgba(32,200,120,0.12); border-color: rgba(32,200,120,0.3); color: #7de8b8;
}
.btn-green:hover { background: rgba(32,200,120,0.2); }
.btn-gold {
  background: linear-gradient(135deg, var(--gold-glow), rgba(201,170,111,0.08));
  border-color: rgba(201,170,111,0.3); color: var(--gold2);
}
.btn-gold:hover { background: rgba(201,170,111,0.2); }
.btn-danger {
  background: rgba(240,64,96,0.08); border-color: rgba(240,64,96,0.2); color: #ff8899;
}
.btn-danger:hover { background: rgba(240,64,96,0.16); }

/* ── SUMMARY ROW ── */
.summary-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.summary-card {
  background: var(--card); border: 1px solid var(--line);
  border-radius: var(--r2); padding: 18px; text-align: center;
  position: relative; overflow: hidden; transition: all 0.3s;
}
.summary-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
  opacity: 0; transition: opacity 0.3s;
}
.summary-card:hover { transform: translateY(-3px); border-color: var(--line2); }
.summary-card:hover::before { opacity: 1; }
.summary-card:nth-child(1)::before { background: linear-gradient(90deg, var(--green), #7de8b8); }
.summary-card:nth-child(2)::before { background: linear-gradient(90deg, var(--red), #ff8899); }
.summary-card:nth-child(3)::before { background: linear-gradient(90deg, var(--gold), var(--gold2)); }
.summary-val {
  font-family: var(--font-en); font-size: 26px; font-weight: 800; margin-bottom: 4px;
}
.summary-val.green { color: var(--green); }
.summary-val.red   { color: var(--red); }
.summary-val.gold  { color: var(--gold2); }
.summary-lbl { font-size: 12px; color: var(--muted); }

/* ── PROGRESS BAR ── */
.progress-wrap {
  background: var(--card); border: 1px solid var(--line);
  border-radius: var(--r); padding: 16px 20px;
}
.progress-info { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); margin-bottom: 8px; }
.progress-track {
  height: 10px; border-radius: 5px; background: var(--surface2);
  overflow: hidden; border: 1px solid var(--line);
}
.progress-fill {
  height: 100%; border-radius: 5px; transition: width 0.6s ease;
  background: linear-gradient(90deg, var(--green), var(--gold));
}
.progress-fill.over { background: linear-gradient(90deg, var(--gold), var(--red)); }

/* ── ADD ROW ── */
.add-row {
  display: grid; grid-template-columns: 1fr 160px auto; gap: 10px; align-items: center;
}

/* ── TABLE ── */
.table-panel {
  background: var(--card); border: 1px solid var(--line);
  border-radius: var(--r2); overflow: hidden;
}
.table-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px 22px; border-bottom: 1px solid var(--line);
}
.table-title { font-size: 15px; font-weight: 700; }
.table-count {
  padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700;
  background: rgba(255,255,255,0.06); color: var(--muted);
}
.table-wrap { overflow-x: auto; }
table {
  width: 100%; border-collapse: collapse; font-size: 14px;
}
thead { background: var(--surface2); }
th {
  padding: 12px 18px; text-align: right; font-size: 12px; font-weight: 700;
  color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px;
  border-bottom: 1px solid var(--line);
  white-space: nowrap;
}
td {
  padding: 14px 18px; border-bottom: 1px solid var(--line);
  vertical-align: middle;
}
tr { transition: background 0.2s; }
tbody tr:hover { background: rgba(255,255,255,0.02); }
.td-num {
  font-family: var(--font-en); font-weight: 600; color: var(--text2);
  width: 40px; text-align: center;
}
.td-name { font-weight: 600; }
.td-amount {
  font-family: var(--font-en); font-weight: 700; font-size: 15px;
  color: var(--red); white-space: nowrap;
}
.td-date { font-size: 12px; color: var(--muted); white-space: nowrap; }
.td-actions { white-space: nowrap; }
.td-del {
  width: 28px; height: 28px; border-radius: 8px;
  background: rgba(240,64,96,0.06); border: 1px solid rgba(240,64,96,0.15);
  color: #ff8899; font-size: 13px; cursor: pointer;
  display: inline-grid; place-items: center; transition: all 0.2s;
  font-family: monospace;
}
.td-del:hover { background: rgba(240,64,96,0.18); border-color: rgba(240,64,96,0.35); }
.table-empty {
  text-align: center; padding: 50px 20px; color: var(--muted); font-size: 14px;
}
.table-empty-icon { font-size: 36px; margin-bottom: 10px; opacity: 0.4; }
.table-footer {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 22px; border-top: 1px solid var(--line);
  font-size: 13px; color: var(--muted);
}
.table-footer strong { color: var(--text); font-family: var(--font-en); }

/* ── PAYWALL ── */
.paywall-overlay {
  position: fixed; inset: 0; z-index: 9999;
  background: rgba(2,3,4,0.92);
  backdrop-filter: blur(18px);
  display: flex; align-items: center; justify-content: center;
  padding: 20px;
}
.paywall-overlay.hidden { display: none; }
.paywall-card {
  background: var(--card);
  border: 1px solid var(--line2);
  border-radius: var(--r2);
  max-width: 440px; width: 100%;
  text-align: center;
  padding: 40px 30px;
  position: relative;
  overflow: hidden;
  animation: payFadeIn 0.5s ease;
}
@keyframes payFadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}
.paywall-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: linear-gradient(90deg, var(--gold), var(--gold3), var(--gold));
}
.paywall-icon {
  font-size: 48px; margin-bottom: 16px; display: block;
}
.paywall-title {
  font-size: 22px; font-weight: 800; color: var(--text); margin-bottom: 8px;
}
.paywall-desc {
  font-size: 14px; color: var(--muted); line-height: 1.7; margin-bottom: 20px;
}
.paywall-price {
  font-family: var(--font-en); font-size: 38px; font-weight: 800;
  color: var(--gold2); margin-bottom: 4px;
}
.paywall-period {
  font-size: 13px; color: var(--muted); margin-bottom: 24px;
}
.paywall-trial-badge {
  display: inline-block; padding: 5px 14px;
  background: rgba(32,200,120,0.1); border: 1px solid rgba(32,200,120,0.25);
  border-radius: 20px; color: #7de8b8; font-size: 12px; font-weight: 700;
  margin-bottom: 20px;
}
.paywall-divider {
  display: flex; align-items: center; gap: 12px;
  margin: 18px 0; color: var(--muted); font-size: 12px;
}
.paywall-divider::before, .paywall-divider::after {
  content: ''; flex: 1; height: 1px; background: var(--line);
}
.paywall-channels { display: flex; flex-direction: column; gap: 10px; }
.paywall-ch {
  display: flex; align-items: center; justify-content: center; gap: 10px;
  padding: 14px 20px; border-radius: var(--r);
  font-size: 14px; font-weight: 700;
  cursor: pointer; transition: all 0.25s; border: 1px solid;
}
.paywall-ch--wa {
  background: rgba(37,211,102,0.08); border-color: rgba(37,211,102,0.3); color: #25d366;
}
.paywall-ch--wa:hover { background: rgba(37,211,102,0.18); transform: translateY(-2px); }
.paywall-ch--ig {
  background: linear-gradient(135deg, rgba(228,64,95,0.08), rgba(131,58,180,0.08));
  border-color: rgba(228,64,95,0.3); color: #e4405f;
}
.paywall-ch--ig:hover { background: linear-gradient(135deg, rgba(228,64,95,0.18), rgba(131,58,180,0.18)); transform: translateY(-2px); }
.paywall-ch i { font-size: 18px; }
.paywall-trial-btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 12px 24px; border-radius: var(--r);
  background: linear-gradient(135deg, rgba(32,200,120,0.12), rgba(32,200,120,0.06));
  border: 1px solid rgba(32,200,120,0.3);
  color: #7de8b8; font-size: 14px; font-weight: 700;
  cursor: pointer; transition: all 0.25s; margin-bottom: 14px;
  font-family: var(--font-ar);
}
.paywall-trial-btn:hover { background: rgba(32,200,120,0.2); transform: translateY(-2px); }

/* ── NOTICE ── */
.app-notice {
  position: fixed; top: -60px; left: 50%; transform: translateX(-50%);
  padding: 12px 24px; border-radius: var(--r);
  font-size: 13px; font-weight: 600; z-index: 999;
  transition: top 0.4s cubic-bezier(0.16,1,0.3,1);
  backdrop-filter: blur(12px);
}
.app-notice.show { top: 20px; }
.app-notice.success { background: rgba(32,200,120,0.15); border: 1px solid rgba(32,200,120,0.3); color: #7de8b8; }
.app-notice.error   { background: rgba(240,64,96,0.15); border: 1px solid rgba(240,64,96,0.3); color: #ff8899; }
.app-notice.info    { background: rgba(58,127,255,0.12); border: 1px solid rgba(58,127,255,0.25); color: #9dc8ff; }

/* ══════════════════════════════════════
   ANALYTICS / CHARTS
══════════════════════════════════════ */
.analytics-section {
  display: grid; gap: 12px;
}
.analytics-header {
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 8px;
}
.analytics-title {
  font-size: 14px; font-weight: 800;
  display: flex; align-items: center; gap: 8px;
}
.analytics-title::before {
  content: ''; width: 3px; height: 16px;
  background: linear-gradient(180deg, var(--gold), var(--gold2));
  border-radius: 4px;
}
.analytics-tabs {
  display: flex; gap: 3px; background: var(--surface2);
  border: 1px solid var(--line); border-radius: var(--r); padding: 2px;
}
.analytics-tab {
  padding: 5px 10px; border-radius: 8px; font-size: 10px; font-weight: 700;
  color: var(--muted); cursor: pointer; transition: all 0.25s;
  border: none; background: transparent; font-family: var(--font-ar);
}
.analytics-tab.active {
  background: rgba(201,170,111,0.15); color: var(--gold2);
  box-shadow: 0 2px 8px rgba(201,170,111,0.1);
}
.analytics-tab:hover:not(.active) { color: var(--text2); }
.charts-grid {
  display: grid; grid-template-columns: 1fr; gap: 10px;
}
.chart-card {
  background: var(--card); border: 1px solid var(--line);
  border-radius: var(--r); padding: 14px;
  position: relative; overflow: hidden; transition: all 0.3s;
}
.chart-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, transparent, var(--gold), transparent);
  opacity: 0; transition: opacity 0.3s;
}
.chart-card:hover { border-color: var(--line2); }
.chart-card:hover::before { opacity: 0.6; }
.chart-card-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 10px;
}
.chart-card-title {
  font-size: 12px; font-weight: 700;
  display: flex; align-items: center; gap: 6px;
}
.chart-card-title i {
  width: 22px; height: 22px; border-radius: 6px;
  display: grid; place-items: center; font-size: 11px;
}
.chart-card-title i.icon-bar { background: rgba(58,127,255,0.12); color: var(--blue); }
.chart-card-title i.icon-pie { background: rgba(201,170,111,0.12); color: var(--gold2); }
.chart-card-title i.icon-line { background: rgba(32,200,120,0.12); color: var(--green); }
.chart-card-title i.icon-radar { background: rgba(160,120,255,0.12); color: #a78bfa; }
.chart-card-badge {
  padding: 2px 8px; border-radius: 20px; font-size: 9px; font-weight: 700;
  background: rgba(255,255,255,0.04); color: var(--muted);
  font-family: var(--font-en);
}
.chart-canvas-wrap {
  position: relative; width: 100%;
}
.chart-canvas-wrap canvas { width: 100% !important; }

/* Mini insight cards */
.insights-row {
  display: grid; grid-template-columns: 1fr 1fr; gap: 8px;
}
.insight-card {
  background: var(--card); border: 1px solid var(--line);
  border-radius: var(--r); padding: 10px 12px;
  position: relative; overflow: hidden; transition: all 0.3s;
}
.insight-card:hover { border-color: var(--line2); transform: translateY(-2px); }
.insight-card::after {
  content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 2px;
}
.insight-card:nth-child(1)::after { background: var(--blue); }
.insight-card:nth-child(2)::after { background: var(--red); }
.insight-card:nth-child(3)::after { background: var(--green); }
.insight-card:nth-child(4)::after { background: #a78bfa; }
.insight-icon {
  font-size: 14px; margin-bottom: 4px;
}
.insight-val {
  font-family: var(--font-en); font-size: 15px; font-weight: 800;
  margin-bottom: 1px;
}
.insight-lbl {
  font-size: 10px; color: var(--muted);
}

/* Full-width row */
.charts-full {
  display: grid; grid-template-columns: 1fr; gap: 10px;
}

/* No data state */
.chart-empty {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 40px 20px; color: var(--muted); font-size: 13px; text-align: center;
  min-height: 220px;
}
.chart-empty-icon { font-size: 32px; margin-bottom: 10px; opacity: 0.4; }

/* Heatmap calendar */
.heatmap-grid {
  display: flex; flex-wrap: wrap; gap: 3px;
}
.heatmap-cell {
  width: 14px; height: 14px; border-radius: 3px;
  background: var(--surface2); border: 1px solid var(--line);
  transition: all 0.2s;
}
.heatmap-cell.l1 { background: rgba(240,64,96,0.15); border-color: rgba(240,64,96,0.2); }
.heatmap-cell.l2 { background: rgba(240,64,96,0.30); border-color: rgba(240,64,96,0.35); }
.heatmap-cell.l3 { background: rgba(240,64,96,0.50); border-color: rgba(240,64,96,0.5); }
.heatmap-cell.l4 { background: rgba(240,64,96,0.75); border-color: rgba(240,64,96,0.7); }
.heatmap-cell:hover { transform: scale(1.4); z-index: 2; }
.heatmap-legend {
  display: flex; align-items: center; gap: 6px; margin-top: 10px;
  font-size: 10px; color: var(--muted);
}
.heatmap-legend .heatmap-cell { width: 12px; height: 12px; cursor: default; }
.heatmap-legend .heatmap-cell:hover { transform: none; }

/* ── RESPONSIVE ── */
@media(max-width:960px){
  .main-layout { grid-template-columns: 1fr; }
  .main-layout > .analytics-section { position: static; }
}
@media(max-width:700px){
  .summary-row { grid-template-columns: 1fr; }
  .add-row { grid-template-columns: 1fr; }
  .income-panel { grid-template-columns: 1fr; }
  .topbar { padding: 12px 16px; }
  .topbar-sep, .topbar-title { display: none; }
  .income-display { font-size: 28px; }
  th, td { padding: 10px 12px; }
  .insights-row { grid-template-columns: 1fr 1fr; }
}
  </style>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore-compat.js"></script>
<script src="../firebase-config.js"></script>
</head>
<body>

<!-- NOTICE -->
<div class="app-notice" id="appNotice"></div>

<!-- TOPBAR -->
<div class="topbar">
  <div class="topbar-brand">
    <div class="topbar-logo">IAAS</div>
    <div class="topbar-sep"></div>
    <div class="topbar-title">جدولة المصاريف</div>
  </div>
  <a class="topbar-back" href="../iass-main.html">→ الرئيسية</a>
</div>

<!-- SHELL -->
<div class="shell">

  <!-- INCOME -->
  <div class="income-panel">
    <div>
      <div class="income-label">المدخول الكلي (الراتب / الدخل الشهري)</div>
      <div class="income-display" id="incomeDisplay">0 د.ع</div>
    </div>
    <div style="display:flex;gap:8px;align-items:end">
      <input class="fi" id="incomeInput" type="number" min="0" step="1" placeholder="أدخل المبلغ (د.ع)" style="width:180px">
      <button class="btn btn-green" id="incomeSaveBtn">حفظ المدخول</button>
    </div>
  </div>

  <!-- SUMMARY -->
  <div class="summary-row">
    <div class="summary-card">
      <div class="summary-val green" id="statIncome">0 د.ع</div>
      <div class="summary-lbl">المدخول</div>
    </div>
    <div class="summary-card">
      <div class="summary-val red" id="statExpenses">0 د.ع</div>
      <div class="summary-lbl">إجمالي المصاريف</div>
    </div>
    <div class="summary-card">
      <div class="summary-val gold" id="statRemaining">0 د.ع</div>
      <div class="summary-lbl">المتبقي</div>
    </div>
  </div>

  <!-- PROGRESS -->
  <div class="progress-wrap">
    <div class="progress-info">
      <span>نسبة الإنفاق من المدخول</span>
      <span id="progressPercent" style="font-family:var(--font-en)">0%</span>
    </div>
    <div class="progress-track">
      <div class="progress-fill" id="progressFill" style="width:0%"></div>
    </div>
  </div>

  <!-- ADD EXPENSE -->
  <div class="add-row">
    <input class="fi" id="expName" type="text" placeholder="اسم المصروف (مثال: إيجار، بنزين، فاتورة...)">
    <input class="fi" id="expAmount" type="number" min="0" step="1" placeholder="المبلغ (د.ع)">
    <button class="btn btn-gold" id="expAddBtn">+ إضافة</button>
  </div>

  <!-- ═══ MAIN LAYOUT: TABLE + ANALYTICS ═══ -->
  <div class="main-layout">

  <!-- TABLE -->
  <div class="table-panel">
    <div class="table-head">
      <div class="table-title">جدول المصاريف</div>
      <div style="display:flex;gap:8px;align-items:center">
        <span class="table-count" id="tableCount">0 مصروف</span>
        <button class="btn btn-danger" id="clearAllBtn" style="padding:7px 12px;font-size:12px">🗑 حذف الكل</button>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>اسم المصروف</th>
            <th>المبلغ</th>
            <th>التاريخ</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="expTableBody">
        </tbody>
      </table>
    </div>
    <div class="table-footer">
      <span>الإجمالي</span>
      <strong id="tableTotal">0 د.ع</strong>
    </div>
  </div>

  <!-- ANALYTICS SIDEBAR -->
  <div class="analytics-section" id="analyticsSection">
    <div class="analytics-header">
      <div class="analytics-title">التحليلات والرسوم البيانية</div>
      <div class="analytics-tabs" id="analyticsTabs">
        <button class="analytics-tab active" data-view="overview">نظرة عامة</button>
        <button class="analytics-tab" data-view="daily">يومي</button>
        <button class="analytics-tab" data-view="heatmap">خريطة حرارية</button>
      </div>
    </div>

    <!-- Insight cards -->
    <div class="insights-row" id="insightsRow">
      <div class="insight-card">
        <div class="insight-icon">📊</div>
        <div class="insight-val" id="insAvg">0</div>
        <div class="insight-lbl">متوسط المصروف</div>
      </div>
      <div class="insight-card">
        <div class="insight-icon">🔺</div>
        <div class="insight-val" id="insMax">0</div>
        <div class="insight-lbl">أعلى مصروف</div>
      </div>
      <div class="insight-card">
        <div class="insight-icon">📅</div>
        <div class="insight-val" id="insToday">0</div>
        <div class="insight-lbl">مصاريف اليوم</div>
      </div>
      <div class="insight-card">
        <div class="insight-icon">⚡</div>
        <div class="insight-val" id="insRate">0%</div>
        <div class="insight-lbl">معدل الاستهلاك</div>
      </div>
    </div>

    <!-- Overview charts -->
    <div class="charts-grid" id="chartsOverview">
      <div class="chart-card">
        <div class="chart-card-head">
          <div class="chart-card-title"><i class="fa-solid fa-chart-column icon-bar"></i>المصاريف حسب الاسم</div>
          <span class="chart-card-badge" id="barChartBadge">0 عنصر</span>
        </div>
        <div class="chart-canvas-wrap" style="height:180px"><canvas id="chartBar"></canvas></div>
      </div>
      <div class="chart-card">
        <div class="chart-card-head">
          <div class="chart-card-title"><i class="fa-solid fa-chart-pie icon-pie"></i>نسبة كل مصروف</div>
          <span class="chart-card-badge" id="pieChartBadge">توزيع</span>
        </div>
        <div class="chart-canvas-wrap" style="height:200px"><canvas id="chartPie"></canvas></div>
      </div>
    </div>

    <!-- Daily chart -->
    <div class="charts-full" id="chartsDaily" style="display:none">
      <div class="chart-card">
        <div class="chart-card-head">
          <div class="chart-card-title"><i class="fa-solid fa-chart-line icon-line"></i>الإنفاق اليومي (آخر 30 يوم)</div>
          <span class="chart-card-badge" id="lineChartBadge">30 يوم</span>
        </div>
        <div class="chart-canvas-wrap" style="height:180px"><canvas id="chartLine"></canvas></div>
      </div>
      <div class="chart-card">
        <div class="chart-card-head">
          <div class="chart-card-title"><i class="fa-solid fa-chart-area icon-line"></i>التراكمي مقابل المدخول</div>
        </div>
        <div class="chart-canvas-wrap" style="height:160px"><canvas id="chartCumulative"></canvas></div>
      </div>
      <div class="chart-card">
        <div class="chart-card-head">
          <div class="chart-card-title"><i class="fa-solid fa-bullseye icon-radar"></i>توزيع المصاريف (رادار)</div>
        </div>
        <div class="chart-canvas-wrap" style="height:180px"><canvas id="chartRadar"></canvas></div>
      </div>
    </div>

    <!-- Heatmap -->
    <div class="charts-full" id="chartsHeatmap" style="display:none">
      <div class="chart-card">
        <div class="chart-card-head">
          <div class="chart-card-title"><i class="fa-solid fa-fire icon-pie"></i>خريطة الإنفاق الحرارية (آخر 90 يوم)</div>
        </div>
        <div id="heatmapContainer" style="padding:8px 0"></div>
      </div>
    </div>
  </div>

  </div><!-- end .main-layout -->

</div>

<!-- PAYWALL -->
<div class="paywall-overlay hidden" id="paywallOverlay">
  <div class="paywall-card">
    <span class="paywall-icon">🔒</span>
    <div class="paywall-title">خدمة جدولة المصاريف</div>
    <div class="paywall-desc">اشترك للوصول الكامل لخدمة تتبع المصاريف والمدخول</div>
    <div class="paywall-price">$5</div>
    <div class="paywall-period">شهرياً</div>
    <div id="trialSection">
      <div class="paywall-trial-badge">🎁 تجربة مجانية ليوم واحد</div>
      <br>
      <button class="paywall-trial-btn" id="startTrialBtn">✨ ابدأ التجربة المجانية</button>
    </div>
    <div class="paywall-divider">اشترك عبر</div>
    <div class="paywall-channels">
      <button class="paywall-ch paywall-ch--wa" id="payWaBtn"><i class="fa-brands fa-whatsapp"></i> واتساب</button>
      <button class="paywall-ch paywall-ch--ig" id="payIgBtn"><i class="fa-brands fa-instagram"></i> انستغرام</button>
    </div>
    <div class="paywall-divider">أو أدخل كود التفعيل</div>
    <div style="display:flex;gap:8px">
      <input class="fi" id="actCodeInput" type="text" placeholder="أدخل كود التفعيل..." style="flex:1;text-align:center;font-family:var(--font-en);letter-spacing:2px;text-transform:uppercase">
      <button class="btn btn-gold" id="actCodeBtn" style="white-space:nowrap">تفعيل</button>
    </div>
    <div id="actCodeMsg" style="font-size:12px;margin-top:6px;min-height:18px"></div>
  </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const SUB_KEY = 'iaas-expenses-sub';
  const TRIAL_KEY = 'iaas-expenses-trial';
  const ONE_DAY = 24 * 60 * 60 * 1000;

  function checkAccess() {
    // Check if subscribed (expenses-specific or general subscription)
    if (localStorage.getItem(SUB_KEY) === '1') return true;
    if (localStorage.getItem('iass-sub-active') === '1') return true;
    // Check trial
    const trialStart = localStorage.getItem(TRIAL_KEY);
    if (trialStart) {
      const elapsed = Date.now() - Number(trialStart);
      if (elapsed < ONE_DAY) return true;
    }
    return false;
  }

  function showPaywall() {
    const overlay = document.getElementById('paywallOverlay');
    const trialSection = document.getElementById('trialSection');
    const trialStart = localStorage.getItem(TRIAL_KEY);
    // Hide trial button if trial was already used
    if (trialStart) trialSection.style.display = 'none';
    overlay.classList.remove('hidden');
  }

  function hidePaywall() {
    document.getElementById('paywallOverlay').classList.add('hidden');
  }

  // Trial button
  document.getElementById('startTrialBtn').addEventListener('click', () => {
    localStorage.setItem(TRIAL_KEY, String(Date.now()));
    hidePaywall();
  });

  // WhatsApp subscribe
  document.getElementById('payWaBtn').addEventListener('click', () => {
    const user = JSON.parse(localStorage.getItem('iass-user') || '{}');
    const msg = `مرحباً، أريد الاشتراك في خدمة جدولة المصاريف ($5/شهر)\nالاسم: ${user.name || '—'}\nالإيميل: ${user.email || '—'}`;
    window.open('https://api.whatsapp.com/send?phone=9647724447343&text=' + encodeURIComponent(msg), '_blank');
  });

  // Instagram subscribe
  document.getElementById('payIgBtn').addEventListener('click', () => {
    window.open('https://instagram.com/iass_118', '_blank');
  });

  // Activation code
  const ACT_CODES_KEY = 'iaas-activation-codes';
  function validateActCode(code) {
    try {
      const codes = JSON.parse(localStorage.getItem(ACT_CODES_KEY) || '[]');
      const c = codes.find(x => x.code === code.trim().toUpperCase());
      if (!c) return { ok: false, msg: 'الكود غير موجود' };
      if (!c.active) return { ok: false, msg: 'الكود غير مفعل' };
      if ((c.uses || 0) >= (c.maxUses || 1)) return { ok: false, msg: 'الكود استُنفد' };
      if (c.service !== 'all' && c.service !== 'expenses') return { ok: false, msg: 'الكود غير صالح لهذه الخدمة' };
      return { ok: true, code: c };
    } catch { return { ok: false, msg: 'خطأ في التحقق' }; }
  }
  document.getElementById('actCodeBtn').addEventListener('click', () => {
    const input = document.getElementById('actCodeInput');
    const msgEl = document.getElementById('actCodeMsg');
    const val = (input.value || '').trim().toUpperCase();
    if (!val) { msgEl.style.color = '#ff8899'; msgEl.textContent = 'أدخل الكود'; return; }
    const res = validateActCode(val);
    if (!res.ok) { msgEl.style.color = '#ff8899'; msgEl.textContent = res.msg; return; }
    // Activate
    localStorage.setItem(SUB_KEY, '1');
    // Increment usage
    try {
      const codes = JSON.parse(localStorage.getItem(ACT_CODES_KEY) || '[]');
      const i = codes.findIndex(x => x.code === val);
      if (i >= 0) { codes[i].uses = (codes[i].uses || 0) + 1; localStorage.setItem(ACT_CODES_KEY, JSON.stringify(codes)); dbSave(ACT_CODES_KEY, codes); }
    } catch {}
    msgEl.style.color = '#7de8b8'; msgEl.textContent = 'تم التفعيل بنجاح ✓';
    setTimeout(() => hidePaywall(), 600);
  });

  // Check access on load
  if (!checkAccess()) {
    showPaywall();
  }
  // Firebase: load activation codes from Firestore
  dbLoad('iaas-activation-codes').then(codes=>{
    if(codes.length) localStorage.setItem('iaas-activation-codes',JSON.stringify(codes));
  }).catch(()=>{});

  const EXPENSES_KEY = 'iaas-expenses';
  const INCOME_KEY   = 'iaas-income';

  // ── Notice ──
  let noticeTimer;
  function showNotice(msg, type='info') {
    const el = document.getElementById('appNotice');
    el.textContent = msg;
    el.className = `app-notice show ${type}`;
    clearTimeout(noticeTimer);
    noticeTimer = setTimeout(() => el.className = 'app-notice', 2400);
  }

  // ── Storage ──
  function loadExpenses() {
    try { return JSON.parse(localStorage.getItem(EXPENSES_KEY) || '[]'); } catch { return []; }
  }
  function saveExpenses(list) { localStorage.setItem(EXPENSES_KEY, JSON.stringify(list)); }
  function getIncome() { return parseFloat(localStorage.getItem(INCOME_KEY) || '0'); }
  function setIncome(v) { localStorage.setItem(INCOME_KEY, String(v)); }

  // ── Escape HTML ──
  function esc(str) {
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  // ── Render all ──
  function render() {
    const list = loadExpenses();
    const income = getIncome();
    const totalExp = list.reduce((s, e) => s + Number(e.amount || 0), 0);
    const remaining = income - totalExp;
    const pct = income > 0 ? Math.min((totalExp / income) * 100, 100) : 0;

    // Income display
    document.getElementById('incomeDisplay').textContent = income.toLocaleString('ar-IQ') + ' د.ع';
    document.getElementById('incomeInput').value = income || '';

    // Summary
    document.getElementById('statIncome').textContent = income.toLocaleString('ar-IQ') + ' د.ع';
    document.getElementById('statExpenses').textContent = totalExp.toLocaleString('ar-IQ') + ' د.ع';
    const remEl = document.getElementById('statRemaining');
    remEl.textContent = (remaining >= 0 ? '' : '-') + Math.abs(remaining).toLocaleString('ar-IQ') + ' د.ع';
    remEl.style.color = remaining >= 0 ? 'var(--gold2)' : 'var(--red)';

    // Progress
    const fill = document.getElementById('progressFill');
    fill.style.width = pct + '%';
    fill.className = 'progress-fill' + (pct >= 90 ? ' over' : '');
    document.getElementById('progressPercent').textContent = pct.toFixed(0) + '%';

    // Table
    const tbody = document.getElementById('expTableBody');
    const countEl = document.getElementById('tableCount');
    countEl.textContent = list.length + ' مصروف';

    if (!list.length) {
      tbody.innerHTML = `<tr><td colspan="5"><div class="table-empty"><div class="table-empty-icon">📭</div>لا توجد مصاريف — أضف مصروفك الأول من الأعلى</div></td></tr>`;
    } else {
      tbody.innerHTML = list.map((e, i) => `
        <tr data-id="${e.id}">
          <td class="td-num">${i + 1}</td>
          <td class="td-name">${esc(e.name)}</td>
          <td class="td-amount">-${Number(e.amount).toLocaleString('ar-IQ')} د.ع</td>
          <td class="td-date">${new Date(e.date).toLocaleDateString('ar-IQ')}</td>
          <td class="td-actions"><button class="td-del" data-id="${e.id}">✕</button></td>
        </tr>
      `).join('');
    }

    document.getElementById('tableTotal').textContent = totalExp.toLocaleString('ar-IQ') + ' د.ع';

    // Delete btns
    tbody.querySelectorAll('.td-del').forEach(btn => {
      btn.addEventListener('click', () => {
        const updated = loadExpenses().filter(x => x.id !== btn.dataset.id);
        saveExpenses(updated);
        render();
        showNotice('تم حذف المصروف', 'info');
      });
    });
  }

  // ── Save income ──
  document.getElementById('incomeSaveBtn').addEventListener('click', () => {
    const v = parseFloat(document.getElementById('incomeInput').value || '0');
    if (v < 0) { showNotice('أدخل مبلغ صحيح', 'error'); return; }
    setIncome(v);
    render();
    showNotice('تم حفظ المدخول ✓', 'success');
  });

  // ── Add expense ──
  document.getElementById('expAddBtn').addEventListener('click', addExpense);
  document.getElementById('expName').addEventListener('keydown', e => { if (e.key === 'Enter') addExpense(); });
  document.getElementById('expAmount').addEventListener('keydown', e => { if (e.key === 'Enter') addExpense(); });

  function addExpense() {
    const name = (document.getElementById('expName').value || '').trim();
    const amount = parseFloat(document.getElementById('expAmount').value || '0');
    if (!name) { showNotice('أدخل اسم المصروف', 'error'); return; }
    if (!amount || amount <= 0) { showNotice('أدخل مبلغ صحيح', 'error'); return; }

    const list = loadExpenses();
    list.unshift({
      id: 'exp' + Date.now() + Math.floor(Math.random() * 999),
      name,
      amount,
      date: new Date().toISOString().split('T')[0]
    });
    saveExpenses(list);
    render();

    document.getElementById('expName').value = '';
    document.getElementById('expAmount').value = '';
    document.getElementById('expName').focus();
    showNotice('تم إضافة المصروف ✓', 'success');
  }

  // ── Clear all ──
  document.getElementById('clearAllBtn').addEventListener('click', () => {
    if (!loadExpenses().length) return;
    if (!confirm('هل تريد حذف جميع المصاريف؟')) return;
    saveExpenses([]);
    render();
    showNotice('تم حذف جميع المصاريف', 'info');
  });

  // ══════════════════════════════
  // CHARTS ENGINE
  // ══════════════════════════════
  const CHART_COLORS = [
    '#c9aa6f','#3a7fff','#f04060','#20c878','#a78bfa',
    '#f59e0b','#ec4899','#06b6d4','#84cc16','#f97316',
    '#e8cb8a','#60a5fa','#fb7185','#4ade80','#c084fc'
  ];
  const chartInstances = {};

  function destroyChart(key){
    if(chartInstances[key]){chartInstances[key].destroy();delete chartInstances[key];}
  }

  function getGrouped(list){
    const map={};
    list.forEach(e=>{const n=e.name||'أخرى';map[n]=(map[n]||0)+Number(e.amount||0);});
    return Object.entries(map).sort((a,b)=>b[1]-a[1]);
  }

  function getDailyData(list,days){
    const map={};
    const now=new Date();
    for(let i=days-1;i>=0;i--){
      const d=new Date(now);d.setDate(d.getDate()-i);
      map[d.toISOString().split('T')[0]]=0;
    }
    list.forEach(e=>{const d=e.date;if(d in map)map[d]+=Number(e.amount||0);});
    return {labels:Object.keys(map).map(d=>{const p=d.split('-');return p[2]+'/'+p[1];}),values:Object.values(map)};
  }

  function renderInsights(list,income){
    const total=list.reduce((s,e)=>s+Number(e.amount||0),0);
    const avg=list.length?Math.round(total/list.length):0;
    const max=list.length?Math.max(...list.map(e=>Number(e.amount||0))):0;
    const today=new Date().toISOString().split('T')[0];
    const todayTotal=list.filter(e=>e.date===today).reduce((s,e)=>s+Number(e.amount||0),0);
    const rate=income>0?((total/income)*100).toFixed(1):'0';
    document.getElementById('insAvg').textContent=avg.toLocaleString('ar-IQ')+' د.ع';
    document.getElementById('insMax').textContent=max.toLocaleString('ar-IQ')+' د.ع';
    document.getElementById('insToday').textContent=todayTotal.toLocaleString('ar-IQ')+' د.ع';
    document.getElementById('insRate').textContent=rate+'%';
  }

  function renderBarChart(grouped){
    destroyChart('bar');
    const ctx=document.getElementById('chartBar');
    if(!grouped.length){ctx.parentElement.innerHTML='<div class="chart-empty"><div class="chart-empty-icon">📊</div>أضف مصاريف لعرض الرسم البياني</div>';return;}
    const top=grouped.slice(0,10);
    document.getElementById('barChartBadge').textContent=top.length+' عنصر';
    chartInstances.bar=new Chart(ctx,{
      type:'bar',
      data:{
        labels:top.map(g=>g[0]),
        datasets:[{
          data:top.map(g=>g[1]),
          backgroundColor:top.map((_,i)=>CHART_COLORS[i%CHART_COLORS.length]+'cc'),
          borderColor:top.map((_,i)=>CHART_COLORS[i%CHART_COLORS.length]),
          borderWidth:1,borderRadius:6,borderSkipped:false,
          hoverBackgroundColor:top.map((_,i)=>CHART_COLORS[i%CHART_COLORS.length])
        }]
      },
      options:{
        responsive:true,maintainAspectRatio:false,
        indexAxis:'y',
        plugins:{
          legend:{display:false},
          tooltip:{
            backgroundColor:'#0c1019ee',titleColor:'#e8cb8a',bodyColor:'#edf0f5',
            borderColor:'rgba(201,170,111,0.25)',borderWidth:1,cornerRadius:10,padding:12,
            callbacks:{label:ctx=>Number(ctx.raw).toLocaleString('ar-IQ')+' د.ع'}
          }
        },
        scales:{
          x:{grid:{color:'rgba(255,255,255,0.04)'},ticks:{color:'#6e7a8e',font:{family:'Syne',size:11},callback:v=>v>=1000?(v/1000)+'K':v}},
          y:{grid:{display:false},ticks:{color:'#b8bfcc',font:{family:'Noto Kufi Arabic',size:11}}}
        }
      }
    });
  }

  function renderPieChart(grouped){
    destroyChart('pie');
    const ctx=document.getElementById('chartPie');
    if(!grouped.length){ctx.parentElement.innerHTML='<div class="chart-empty"><div class="chart-empty-icon">🥧</div>أضف مصاريف لعرض التوزيع</div>';return;}
    const top=grouped.slice(0,8);
    const rest=grouped.slice(8).reduce((s,g)=>s+g[1],0);
    const labels=[...top.map(g=>g[0])];const vals=[...top.map(g=>g[1])];
    if(rest>0){labels.push('أخرى');vals.push(rest);}
    document.getElementById('pieChartBadge').textContent=labels.length+' فئة';
    chartInstances.pie=new Chart(ctx,{
      type:'doughnut',
      data:{
        labels,
        datasets:[{
          data:vals,
          backgroundColor:labels.map((_,i)=>CHART_COLORS[i%CHART_COLORS.length]+'bb'),
          borderColor:'#0c1019',borderWidth:3,hoverOffset:8
        }]
      },
      options:{
        responsive:true,maintainAspectRatio:false,cutout:'62%',
        plugins:{
          legend:{position:'bottom',labels:{color:'#b8bfcc',font:{family:'Noto Kufi Arabic',size:11},padding:12,usePointStyle:true,pointStyleWidth:8}},
          tooltip:{
            backgroundColor:'#0c1019ee',titleColor:'#e8cb8a',bodyColor:'#edf0f5',
            borderColor:'rgba(201,170,111,0.25)',borderWidth:1,cornerRadius:10,padding:12,
            callbacks:{
              label:ctx=>{
                const total=ctx.dataset.data.reduce((a,b)=>a+b,0);
                const pct=total?((ctx.raw/total)*100).toFixed(1):0;
                return ctx.label+': '+Number(ctx.raw).toLocaleString('ar-IQ')+' د.ع ('+pct+'%)';
              }
            }
          }
        }
      }
    });
  }

  function renderLineChart(list){
    destroyChart('line');
    const ctx=document.getElementById('chartLine');
    const daily=getDailyData(list,30);
    const hasData=daily.values.some(v=>v>0);
    if(!hasData){ctx.parentElement.innerHTML='<div class="chart-empty"><div class="chart-empty-icon">📈</div>لا توجد بيانات للأيام الأخيرة</div>';return;}
    const avg=daily.values.reduce((a,b)=>a+b,0)/daily.values.length;
    chartInstances.line=new Chart(ctx,{
      type:'line',
      data:{
        labels:daily.labels,
        datasets:[
          {
            label:'الإنفاق اليومي',data:daily.values,
            borderColor:'#f04060',backgroundColor:'rgba(240,64,96,0.08)',
            fill:true,tension:0.4,borderWidth:2.5,pointRadius:3,
            pointBackgroundColor:'#f04060',pointBorderColor:'#0c1019',pointBorderWidth:2,
            pointHoverRadius:6
          },
          {
            label:'المتوسط',data:daily.values.map(()=>avg),
            borderColor:'rgba(201,170,111,0.5)',borderDash:[6,4],borderWidth:1.5,
            pointRadius:0,fill:false
          }
        ]
      },
      options:{
        responsive:true,maintainAspectRatio:false,
        interaction:{intersect:false,mode:'index'},
        plugins:{
          legend:{labels:{color:'#b8bfcc',font:{family:'Noto Kufi Arabic',size:11},usePointStyle:true,padding:14}},
          tooltip:{
            backgroundColor:'#0c1019ee',titleColor:'#e8cb8a',bodyColor:'#edf0f5',
            borderColor:'rgba(201,170,111,0.25)',borderWidth:1,cornerRadius:10,padding:12,
            callbacks:{label:ctx=>ctx.dataset.label+': '+Number(ctx.raw).toLocaleString('ar-IQ')+' د.ع'}
          }
        },
        scales:{
          x:{grid:{color:'rgba(255,255,255,0.03)'},ticks:{color:'#6e7a8e',font:{size:10},maxRotation:45}},
          y:{grid:{color:'rgba(255,255,255,0.04)'},ticks:{color:'#6e7a8e',font:{family:'Syne',size:11},callback:v=>v>=1000?(v/1000)+'K':v}}
        }
      }
    });
  }

  function renderCumulativeChart(list,income){
    destroyChart('cumulative');
    const ctx=document.getElementById('chartCumulative');
    const daily=getDailyData(list,30);
    let cumulative=0;
    const cumData=daily.values.map(v=>{cumulative+=v;return cumulative;});
    const incLine=daily.values.map(()=>income);
    chartInstances.cumulative=new Chart(ctx,{
      type:'line',
      data:{
        labels:daily.labels,
        datasets:[
          {
            label:'المصاريف التراكمية',data:cumData,
            borderColor:'#f04060',backgroundColor:'rgba(240,64,96,0.06)',
            fill:true,tension:0.3,borderWidth:2,pointRadius:0
          },
          {
            label:'حد المدخول',data:incLine,
            borderColor:'rgba(32,200,120,0.6)',borderDash:[8,4],borderWidth:2,
            pointRadius:0,fill:false
          }
        ]
      },
      options:{
        responsive:true,maintainAspectRatio:false,
        plugins:{
          legend:{labels:{color:'#b8bfcc',font:{family:'Noto Kufi Arabic',size:11},usePointStyle:true}},
          tooltip:{backgroundColor:'#0c1019ee',titleColor:'#e8cb8a',bodyColor:'#edf0f5',borderColor:'rgba(201,170,111,0.25)',borderWidth:1,cornerRadius:10}
        },
        scales:{
          x:{grid:{color:'rgba(255,255,255,0.03)'},ticks:{color:'#6e7a8e',font:{size:10},maxRotation:45}},
          y:{grid:{color:'rgba(255,255,255,0.04)'},ticks:{color:'#6e7a8e',font:{family:'Syne',size:11}}}
        }
      }
    });
  }

  function renderRadarChart(grouped){
    destroyChart('radar');
    const ctx=document.getElementById('chartRadar');
    if(grouped.length<3){ctx.parentElement.innerHTML='<div class="chart-empty"><div class="chart-empty-icon">🎯</div>أضف 3 مصاريف على الأقل</div>';return;}
    const top=grouped.slice(0,7);
    chartInstances.radar=new Chart(ctx,{
      type:'radar',
      data:{
        labels:top.map(g=>g[0]),
        datasets:[{
          label:'المبلغ',data:top.map(g=>g[1]),
          backgroundColor:'rgba(201,170,111,0.12)',borderColor:'#c9aa6f',borderWidth:2,
          pointBackgroundColor:'#c9aa6f',pointBorderColor:'#0c1019',pointBorderWidth:2,
          pointRadius:4,pointHoverRadius:7
        }]
      },
      options:{
        responsive:true,maintainAspectRatio:false,
        plugins:{
          legend:{display:false},
          tooltip:{backgroundColor:'#0c1019ee',titleColor:'#e8cb8a',bodyColor:'#edf0f5',borderColor:'rgba(201,170,111,0.25)',borderWidth:1,cornerRadius:10}
        },
        scales:{
          r:{
            grid:{color:'rgba(255,255,255,0.06)'},angleLines:{color:'rgba(255,255,255,0.06)'},
            pointLabels:{color:'#b8bfcc',font:{family:'Noto Kufi Arabic',size:11}},
            ticks:{display:false},beginAtZero:true
          }
        }
      }
    });
  }

  function renderHeatmap(list){
    const container=document.getElementById('heatmapContainer');
    const days=90;const now=new Date();
    const dayMap={};
    for(let i=days-1;i>=0;i--){
      const d=new Date(now);d.setDate(d.getDate()-i);
      dayMap[d.toISOString().split('T')[0]]=0;
    }
    list.forEach(e=>{const d=e.date;if(d in dayMap)dayMap[d]+=Number(e.amount||0);});
    const vals=Object.values(dayMap);
    const maxVal=Math.max(...vals,1);
    const q1=maxVal*0.25,q2=maxVal*0.5,q3=maxVal*0.75;
    let html='<div class="heatmap-grid">';
    Object.entries(dayMap).forEach(([date,val])=>{
      let lvl='';
      if(val>0&&val<=q1)lvl='l1';else if(val<=q2)lvl=val>0?'l2':'';else if(val<=q3)lvl='l3';else if(val>q3)lvl='l4';
      const fmt=new Date(date).toLocaleDateString('ar-IQ');
      html+=`<div class="heatmap-cell ${lvl}" title="${fmt}: ${Number(val).toLocaleString('ar-IQ')} د.ع"></div>`;
    });
    html+='</div>';
    html+='<div class="heatmap-legend"><span>أقل</span><div class="heatmap-cell"></div><div class="heatmap-cell l1"></div><div class="heatmap-cell l2"></div><div class="heatmap-cell l3"></div><div class="heatmap-cell l4"></div><span>أكثر</span></div>';
    container.innerHTML=html;
  }

  let currentView='overview';
  function renderCharts(){
    const list=loadExpenses();
    const income=getIncome();
    const grouped=getGrouped(list);
    renderInsights(list,income);
    if(currentView==='overview'){
      renderBarChart(grouped);renderPieChart(grouped);
    }else if(currentView==='daily'){
      renderLineChart(list);renderCumulativeChart(list,income);renderRadarChart(grouped);
    }else if(currentView==='heatmap'){
      renderHeatmap(list);
    }
  }

  // Tab switching
  document.getElementById('analyticsTabs').addEventListener('click',e=>{
    const tab=e.target.closest('.analytics-tab');if(!tab)return;
    document.querySelectorAll('.analytics-tab').forEach(t=>t.classList.remove('active'));
    tab.classList.add('active');
    currentView=tab.dataset.view;
    document.getElementById('chartsOverview').style.display=currentView==='overview'?'grid':'none';
    document.getElementById('chartsDaily').style.display=currentView==='daily'?'block':'none';
    document.getElementById('chartsHeatmap').style.display=currentView==='heatmap'?'block':'none';
    renderCharts();
  });

  // Patch render to also update charts
  const _origRender=render;
  render=function(){
    _origRender();renderCharts();
  };

  // ── Init ──
  render();
});
</script>
</body>
</html>
